# Nexus commerce API base URL.
# Development: the local Nexus instance. Production: https://api.miravika.com
# This is a public URL — it is bundled into the client and is not a secret.
VITE_NEXUS_API_URL=http://localhost:8080

# Customer identity. Must be the Supabase project MIRAVIKA Nexus verifies bearer tokens
# against (the Nexus project), or every signed-in API request is rejected. Public values.
VITE_NEXUS_SUPABASE_URL=
VITE_NEXUS_SUPABASE_PUBLISHABLE_KEY=

# Supabase (Lovable Cloud project for storefront server features such as the email queue).
# Only the PUBLISHABLE key belongs in the frontend. The service-role key,
# Razorpay secret, Shiprocket credentials and SMTP credentials must NEVER be
# added here — they live in the Nexus server environment only.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
