# Nexus commerce API base URL.
# Development: the local Nexus instance. Production: https://api.miravika.com
# This is a public URL — it is bundled into the client and is not a secret.
VITE_NEXUS_API_URL=http://localhost:8080

# Supabase (customer auth + session tokens).
# Only the PUBLISHABLE key belongs in the frontend. The service-role key,
# Razorpay secret, Shiprocket credentials and SMTP credentials must NEVER be
# added here — they live in the Nexus server environment only.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
